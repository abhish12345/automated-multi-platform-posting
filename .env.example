# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real credentials.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────

# ── Dev.to ────────────────────────────────────────────────────
# Get your API key from: https://dev.to/settings/extensions
DEVTO_API_KEY=your_devto_api_key_here

# ── Telegram ──────────────────────────────────────────────────
# Create a bot via @BotFather and get the token.
# TELEGRAM_CHAT_ID: use @channelname (public) or numeric ID (private)
TELEGRAM_BOT_TOKEN=123456789:ABCDEFabcdefABCDEF1234567890abcdef
TELEGRAM_CHAT_ID=@your_channel_name

# ── Mastodon ──────────────────────────────────────────────────
# Create an app in your Mastodon instance:
#   Settings → Development → New Application (write:statuses scope)
MASTODON_ACCESS_TOKEN=your_mastodon_access_token_here
MASTODON_INSTANCE_URL=https://mastodon.social

# ── Discord ───────────────────────────────────────────────────
# Channel Settings → Integrations → Webhooks → New Webhook → Copy Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_id/your_token

# ── Pastebin ──────────────────────────────────────────────────
# Get your Developer API key from: https://pastebin.com/doc_api
PASTEBIN_API_KEY=your_pastebin_api_dev_key_here
